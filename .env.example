# Local development PostgreSQL. Use the same credentials in the Compose DSN.
POSTGRES_USER=civitas
POSTGRES_DB=civitas
POSTGRES_PASSWORD=civitas-local
CIVITAS_POSTGRES_PORT=55432
CIVITAS_COMPOSE_DATABASE_URL=postgresql+psycopg://civitas:civitas-local@db:5432/civitas

# Leave the Discord token blank for migrations and database tests.
CIVITAS_DISCORD_TOKEN=
CIVITAS_DISCORD_GUILD_ID=
# Comma-separated Discord user IDs admitted to the development guild.
CIVITAS_ALLOWED_USER_IDS=
