# Local development PostgreSQL. Use the same credentials in the Compose DSN.
POSTGRES_USER=civitas
POSTGRES_DB=civitas
POSTGRES_PASSWORD=civitas-local
CIVITAS_POSTGRES_PORT=55432
CIVITAS_COMPOSE_DATABASE_URL=postgresql+psycopg://civitas:civitas-local@db:5432/civitas

# Leave the Discord token blank for migrations and database tests.
CIVITAS_DISCORD_TOKEN=
CIVITAS_DISCORD_GUILD_ID=
# Optional. Create a dedicated role such as Citizen and paste its Discord role ID.
CIVITAS_CITIZEN_ROLE_ID=
# Comma-separated Discord user IDs admitted to the development guild.
CIVITAS_ALLOWED_USER_IDS=

# Fill in both amounts to enable the wallet. Proposed test values: 250 and 8000.
CIVITAS_STARTER_GRANT=
CIVITAS_TREASURY_GENESIS=
CIVITAS_CURRENCY_SYMBOL=₵

# Fill in reviewer IDs and the five amounts to enable NPC work.
# Proposed test amounts: 800 / 300 / 100 per week, rewards 10–40.
CIVITAS_NPC_REVIEWER_IDS=
CIVITAS_BUDGET_WEEKLY_LIMIT=
CIVITAS_NPC_WEEKLY_LIMIT=
CIVITAS_NPC_PERSONAL_WEEKLY_LIMIT=
CIVITAS_NPC_REWARD_MIN=
CIVITAS_NPC_REWARD_MAX=
CIVITAS_BUDGET_TIMEZONE=UTC
CIVITAS_NPC_COOLDOWN_MINUTES=0

# Proposed marketplace test values: fee 150, company limit 1, sales tax 1000 bp.
CIVITAS_COMPANY_FEE=
CIVITAS_COMPANY_LIMIT=
CIVITAS_SALES_TAX_BP=
CIVITAS_MARKET_ARBITER_IDS=

# Comma-separated registered citizens authorized to issue state assets.
CIVITAS_ASSET_ISSUER_IDS=

# State contracts also use CIVITAS_BUDGET_WEEKLY_LIMIT and CIVITAS_BUDGET_TIMEZONE.
# Proposed test limit for state contracts: 250.
CIVITAS_TREASURY_INITIATOR_IDS=
CIVITAS_TREASURY_APPROVER_IDS=
CIVITAS_CONTRACT_WEEKLY_LIMIT=
